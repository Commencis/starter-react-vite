{
  "name": "@commencis/starter-react-vite",
  "version": "2.11.0",
  "build": "0",
  "description": "Commencis Starter - React Vite",
  "author": "Commencis WEB Team",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.22.2"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint:check:types": "tsc --noEmit",
    "lint:check:js": "eslint .",
    "lint:fix:js": "eslint . --fix",
    "lint:check:css": "stylelint **/*.{css,scss}",
    "lint:fix:css": "stylelint **/*.{css,scss} --fix",
    "lint:check:format": "prettier \"**/*.{json,md}\" --check",
    "lint:fix:format": "prettier \"**/*.{json,md}\" --write",
    "lint": "pnpm run \"/^lint:check:.*/\"",
    "lint:fix": "pnpm run \"/^lint:fix:.*/\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:review": "pnpm run lint && pnpm run test",
    "generate:worker": "pnpm exec msw init ./public --save",
    "prepare": "husky",
    "precommit": "lint-staged"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.3",
    "@reduxjs/toolkit": "2.14.0",
    "axios": "1.21.0",
    "clsx": "2.1.1",
    "i18next": "26.7.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.13",
    "react-redux": "9.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commencis/commitlint-config": "4.1.1",
    "@commencis/eslint-config": "3.8.1",
    "@commencis/eslint-plugin": "3.6.1",
    "@commencis/lint-staged-config": "3.3.0",
    "@commencis/prettier-config": "3.4.0",
    "@commencis/stylelint-config": "3.6.1",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-links": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@svitejs/changesets-changelog-github-compact": "1.2.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "commitlint": "21.2.4",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "jsdom": "31.0.0",
    "lint-staged": "17.6.0",
    "msw": "3.0.4",
    "prettier": "3.9.10",
    "sass-embedded": "1.108.0",
    "storybook": "10.6.6",
    "stylelint": "17.16.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
